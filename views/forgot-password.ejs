<%layout("/layouts/boilerplate.ejs")%>
<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="text-center mb-4">
        <div class="brand-icon-lg mx-auto mb-3"></div>
        <h2 class="fw-bold">Saarthi</h2>
        <p class="text-muted"></p>
      </div>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h5 class="fw-semibold mb-1">Forgot Password</h5>
          <nav class="auth-tabs" aria-label="Recovery method"><a href="/auth/forgot-password?method=sms" class="<%= method==='sms'?'active':'' %>">Mobile SMS</a><a href="/auth/forgot-password" class="<%= method==='email'?'active':'' %>">Email</a></nav>
          <p class="text-muted small mb-4"><%= method==='sms'?'Enter your verified mobile number to request a reset code.':'Enter your email address to request a reset code.' %></p>
          <form action="/auth/forgot-password" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <input type="hidden" name="verificationMethod" value="<%= method %>">
              <% if(method==='sms'){ %>
                <label class="form-label" for="recoveryPhone">Verified mobile number</label><input id="recoveryPhone" type="tel" name="phone" class="form-control" autocomplete="tel" maxlength="40" placeholder="+ followed by country code and number" required>
                <% if(!smsEnabled){ %><p role="status">SMS recovery is currently unavailable. Try again later.</p><% } %>
              <% }else{ %><label class="form-label" for="recoveryEmail">Email</label><input id="recoveryEmail" type="email" name="email" class="form-control" autocomplete="email" placeholder="you@example.com" required><% if(!emailEnabled){ %><p role="status">Email recovery is currently unavailable. Try mobile SMS if your number is verified.</p><% } %><% } %>
            </div>
            <button type="submit" class="btn btn-primary w-100" <%= (method==='sms'&&!smsEnabled)||(method==='email'&&!emailEnabled)?'disabled':'' %>>Send code</button>
          </form>
        </div>
      </div>
      <p class="text-center small text-muted mt-3"><a href="/auth/login">← Back to Login</a></p>
    </div>
  </div>
</main>

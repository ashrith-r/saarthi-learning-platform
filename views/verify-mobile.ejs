<% layout('/layouts/boilerplate.ejs') %>
<main class="container py-5"><section class="studio-card mx-auto" style="max-width:480px">
  <h1>Verify mobile</h1><p>Enter the six-digit code sent to <strong><%= phone %></strong>. Codes expire after 10 minutes.</p>
  <% if(message){ %><p role="status"><%= message %></p><% } %>
  <form class="studio-form" action="/auth/mobile/verify" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="mobileCode">Verification code<input id="mobileCode" name="otpEntered" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus></label>
    <button class="studio-button">Verify mobile</button>
  </form>
  <form action="/auth/mobile/resend" method="post" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="studio-button secondary">Request another code</button></form>
  <p class="mt-3">Wait 60 seconds between requests. Each code allows five attempts.</p>
  <a href="<%= user?'/auth/mobile':'/auth/login?tab=register' %>">Change mobile number</a>
</section></main>

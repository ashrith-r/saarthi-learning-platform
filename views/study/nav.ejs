<aside class="workspace-sidebar">
  <a class="workspace-brand" href="/dashboard"><span class="saarthi-mark" aria-hidden="true"><%= site.name.charAt(0).toLowerCase() %></span><%= site.name %><span class="brand-dot">.</span></a>
  <div class="workspace-caption">NAVIGATION</div>
  <nav class="study-nav" aria-label="Learning workspace">
    <% [['dashboard','Overview','/dashboard','grid'],['library','Learning library','/library','book'],['practice','Mock tests','/practice','clipboard-check'],['insights','Performance','/insights','bar-chart'],['planner','Study planner','/planner','calendar4-week']].forEach(([key,label,url,icon]) => { %>
      <a class="<%= active===key?'selected':'' %>" href="<%= url %>" <%- active===key?'aria-current="page"':'' %>><i class="bi bi-<%= icon %>" aria-hidden="true"></i><%= label %><% if(active===key){ %><span class="nav-active-dot" aria-hidden="true"></span><% } %></a>
    <% }) %>
    <% if(user.admin||user.editor){ %><a href="/admin/materials" class="<%= active==='materials'?'selected':'' %>" <%- active==='materials'?'aria-current="page"':'' %>><i class="bi bi-collection-play" aria-hidden="true"></i>Learning materials</a><a href="/admin/publishing" class="<%= active==='publishing'?'selected':'' %>" <%- active==='publishing'?'aria-current="page"':'' %>><i class="bi bi-layers" aria-hidden="true"></i>Quiz publishing</a><a class="<%= active==='admin'?'selected':'' %>" href="/admin"><i class="bi bi-sliders" aria-hidden="true"></i>Administration</a><a href="/admin/questionBank"><i class="bi bi-question-circle" aria-hidden="true"></i>Question bank</a><% } %>
<% if(user.admin){ %><a href="/admin/site-settings" class="<%= active==='settings'?'selected':'' %>" <%- active==='settings'?'aria-current="page"':'' %>><i class="bi bi-pencil-square" aria-hidden="true"></i>Site settings</a><% } %>
    <a href="/auth/mobile"><i class="bi bi-phone" aria-hidden="true"></i>Mobile verification</a>
  </nav><span class="nav-scroll-hint" aria-hidden="true"><i class="bi bi-arrow-left-right"></i> Swipe to explore navigation</span>
  <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">Reduce scene motion</button><div class="workspace-account"><span class="study-avatar"><%= user.username.slice(0,2).toUpperCase() %></span><span><strong><%= user.username %></strong><small><%= user.admin?'Administrator':user.editor?'Content editor':'Personal workspace' %></small></span><form action="/auth/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button aria-label="Log out" title="Log out"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></button></form></div>
</aside>
<div class="workspace-topbar"><span><span class="muted">My workspace</span><span class="breadcrumb-slash">/</span><%= ({dashboard:'Overview',library:'Learning library',practice:'Mock tests',insights:'Performance',planner:'Study planner',materials:'Learning materials',publishing:'Quiz publishing',settings:'Site settings',admin:'Administration'})[active]||'Content studio' %></span><a href="/library" class="workspace-search"><i class="bi bi-search" aria-hidden="true"></i> Find a chapter <span aria-hidden="true">↗</span></a></div>

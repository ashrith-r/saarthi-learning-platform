<% layout('/layouts/boilerplate.ejs') %>
<main class="studio"><%- include('nav') %>
<header class="study-heading dashboard-intro"><div><h1>Dashboard</h1><p>Chapter progress, practice results and scheduled study sessions.</p></div><a class="studio-button" href="/library">Browse library ↗</a></header>
<section class="learning-constellation" aria-label="Recent chapters"><div class="section-title"><h2>Recent chapters</h2><a href="/library">Explore more chapters</a></div><div class="constellation-nodes"><% const stars=progress.filter(p=>p.chapter).slice(0,4);if(!stars.length){ %><p>No saved chapter progress.</p><% } stars.forEach(p=>{ %><a class="chapter-star" href="/learn/<%= p.chapter._id %>"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 24 15 38 20 24 25 20 38 16 25 2 20 16 15Z"/></svg><span><%= p.chapter.chapterName %></span><small><%= p.completed?'Completed':'Continue learning' %></small></a><% }) %></div></section><section class="metric-grid"><% [[metrics.completed,'Chapters completed','book'],[metrics.accuracy+'%','Practice accuracy','bullseye'],[metrics.tests,'Tests completed','clipboard-check'],[metrics.saved,'Saved chapters','bookmark']].forEach(([value,label,icon])=>{ %><article class="studio-card metric"><span><%= label %></span><strong><%= value %></strong><i class="bi bi-<%= icon %>" aria-hidden="true"></i></article><% }) %></section>
<div class="studio-grid"><section class="studio-card feature-card"><h2><%= profile?.exam || 'Exam target' %></h2><p><%= profile?.targetDate ? Math.max(0, Math.ceil((new Date(profile.targetDate)-new Date(today))/86400000))+' days to your target exam' : 'Set an exam date and weekly chapter goal.' %></p><div class="goal-track"><span style="width:<%= Math.min(100,metrics.weekly/(profile?.weeklyGoal||5)*100) %>%"></span></div><p><%= metrics.weekly %> of <%= profile?.weeklyGoal||5 %> chapters completed this week</p><details><summary>Customize your goal</summary><form action="/study-goal" method="post" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Target exam<input name="exam" maxlength="120" value="<%= profile?.exam||'' %>" required></label><label>Exam date<input name="targetDate" type="date" value="<%= profile?.targetDate||'' %>" required></label><label>Weekly chapter goal<input name="weeklyGoal" type="number" min="1" max="50" value="<%= profile?.weeklyGoal||5 %>" required></label><button class="studio-button">Save goal</button></form></details></section>
<section class="studio-card recommendation-card"><div class="recommendation-icon" aria-hidden="true"><i class="bi bi-lightbulb"></i></div><h2><%= metrics.weakTopics.length ? 'Recommended revision' : 'Practice recommendations' %></h2><p><%= metrics.weakTopics.length ? 'Your recent tests suggest reviewing '+metrics.weakTopics[0][0]+'. Start a targeted revision session.' : 'Complete a test to receive topic recommendations.' %></p><a class="studio-link" href="<%= metrics.weakTopics.length?'/insights':'/library' %>">View recommendations</a></section></div>
<section class="studio-card"><div class="section-title"><h2>Upcoming study sessions</h2><a href="/planner">Plan week ↗</a></div><% const upcoming=tasks.filter(t=>!t.done).slice(0,3); if(!upcoming.length){ %><p class="empty-message">No upcoming study sessions.</p><% } upcoming.forEach(t=>{ %><div class="studio-row"><span class="resource-tile peach"><i class="bi bi-calendar3" aria-hidden="true"></i></span><span><strong><%= t.title %></strong><small><%= t.date %></small></span></div><% }) %></section>
<section class="studio-card"><h2>Learning activity</h2><p><%= metrics.streak %>-day learning streak · based on chapter completions and tests (UTC days)</p><div class="badge-list"><% if(!metrics.badges.length){ %><p>No milestones recorded.</p><% } metrics.badges.forEach(b=>{ %><span> <%= b %></span><% }) %></div></section></main>

<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav', {active:'publishing'}) %><header class="study-heading"><div><h1>Quiz publishing</h1><p>Create quizzes, review drafts and publish tests.</p></div><a class="studio-button" href="/admin/quiz/create">Create a test +</a></header><section class="studio-card"><h2>Quiz publishing</h2><% quizzes.forEach(q=>{ %><details class="studio-row" style="display:block"><summary><strong><%= q.title %></strong> · <%= q.status||'published' %> · <%= q.versions?.length||0 %> revisions</summary><a href="/admin/publishing/<%= q._id %>/preview">Preview test →</a><form class="studio-form" action="/admin/publishing/<%= q._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Status<select name="status"><% ['draft','reviewed','published'].forEach(s=>{ %><option <%= q.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Duration (minutes)<input name="durationMinutes" type="number" min="1" max="240" value="<%= q.durationMinutes||20 %>" required></label><label>Marks per correct answer<input name="marks" type="number" min="1" max="10" step="0.25" value="<%= q.marks||1 %>" required></label><label>Penalty per incorrect answer<input name="penalty" type="number" min="0" max="10" step="0.25" value="<%= q.penalty||0 %>" required></label><button class="studio-button">Save publishing settings</button></form><% q.versions?.slice(-5).reverse().forEach(v=>{ %><p><small><%= new Date(v.changedAt).toISOString().slice(0,16) %> · Previous status: <%= v.settings.status %></small></p><% }) %></details><% }) %></section><div class="studio-grid"><section class="studio-card"><h2>Import questions</h2><p>CSV columns: question,A,B,C,D,answer,solution,tags. Separate tags with |. Validate up to 100 rows before importing.</p><form action="/admin/import-csv" method="post" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Chapter<select name="chapterID" required><% chapters.forEach(c=>{ %><option value="<%= c._id %>" <%= preview?.chapterID===String(c._id)?'selected':'' %>><%= c.chapterName %></option><% }) %></select></label><label>Load CSV file<input type="file" accept=".csv,text/csv" id="csvFile"></label><label>CSV contents<textarea id="csvText" name="csv" rows="7" required><%= csv %></textarea></label><% if(preview){ %><p><%= preview.count %> valid questions</p><% preview.errors.forEach(e=>{ %><p class="text-danger"><%= e %></p><% }) %><% preview.questions.slice(0,5).forEach(q=>{ %><p><%= q %></p><% }) %><% if(!preview.errors.length){ %><label><input name="confirm" type="checkbox" value="yes" required> I reviewed this preview and want to import</label><% } } %><button class="studio-button"><%= preview&&!preview.errors.length?'Import validated questions':'Validate and preview' %></button></form></section><section class="studio-card"><h2>Activity trail</h2><% events.forEach(e=>{ %><div class="studio-row"><span><strong><%= e.action %></strong><small><%= e.actor?.username||'Administrator' %> · <%= e.details %></small></span></div><% }) %></section></div><% if(user.admin){ %><section class="studio-card"><h2>Content editor permissions</h2><p>Editors can prepare and review content. Administrators approve publication.</p><% users.forEach(u=>{ %><form class="studio-row" action="/admin/users/<%= u._id %>/editor" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span><strong><%= u.username %></strong><small><%= u.email %></small></span><label><input type="checkbox" name="editor" <%= u.editor?'checked':'' %>> Content editor</label><button class="studio-button">Save role</button></form><% }) %></section><% } %></main>

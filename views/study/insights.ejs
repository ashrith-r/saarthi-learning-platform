<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav') %><header class="study-heading"><div><h1>Performance</h1><p>Review test scores, subject accuracy and incorrect answers.</p></div><form action="/revision" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="studio-button">Practice my weak topics ↗</button></form></header><% const subjectStats={};runs.forEach(r=>r.result.review.forEach(a=>{const key=a.question.subject||'General';subjectStats[key]||={correct:0,total:0};subjectStats[key].total++;if(a.isCorrect)subjectStats[key].correct++;})); %><section class="studio-card"><h2>Timed test subject accuracy</h2><% Object.entries(subjectStats).forEach(([name,s])=>{ %><div class="studio-row"><strong><%= name %></strong><span><%= Math.round(s.correct/s.total*100) %>% accuracy · <%= s.total %> questions</span></div><% }) %></section><div class="studio-grid"><section class="studio-card"><h2>Accuracy history</h2><div class="chart-bars" role="img" aria-label="Accuracy for your most recent tests"><% runs.slice(0,10).reverse().forEach(r=>{ %><div style="height:<%= Math.max(3,r.result.accuracy) %>%" title="<%= r.title %>: <%= r.result.accuracy %>%"></div><% }) %></div><% if(!runs.length){ %><p>No completed tests.</p><% } runs.slice(0,5).forEach(r=>{ %><a class="studio-row" href="/practice/run/<%= r._id %>"><strong><%= r.title %></strong><b><%= r.result.accuracy %>%</b></a><% }) %></section><section class="studio-card"><h2>Incorrect and skipped questions</h2><p>Review questions and solutions from completed attempts.</p><% if(!mistakes.length){ %><p>No incorrect or skipped questions to display.</p><% } mistakes.slice(0,12).forEach(a=>{ %><details class="studio-row" style="display:block"><summary><%= a.question.question_text %></summary><p><%= a.question.solution?.text||'Review this topic in the learning library.' %></p><a href="/library?q=<%= encodeURIComponent(a.question.chapter||'') %>">Find chapter resources →</a></details><% }) %></section></div><section class="studio-card"><h2>Earlier test results</h2><p>Earlier chapter attempts are included in dashboard totals. Detailed subject and revision analysis above uses timed tests.</p><% if(!legacyAttempts.length){ %><p>No earlier chapter attempts.</p><% }legacyAttempts.forEach(a=>{ %><a class="studio-row" href="/quiz/attempt/<%= a._id %>"><strong><%= a.quiz?.title||'Chapter test' %></strong><span><%= a.score %> / <%= a.totalQuestions %> correct</span></a><% }) %></section></main>

<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav', {active:'publishing'}) %><h1><%= quiz.title %></h1><a href="/admin/publishing">← Quiz publishing</a><% quiz.questions.forEach((q,i)=>{ %><article class="studio-card mt-4"><h2><%= i+1 %>. <%= q.question_text %></h2><div class="test-options"><% q.options.forEach(o=>{ %><label><%= String(o._id)===String(q.correctOption)?' ':'' %><%= o.text %></label><% }) %></div><p><%= q.solution?.text %></p></article><% }) %></main>

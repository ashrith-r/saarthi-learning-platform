<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav') %><header class="study-heading"><div><h1>Learning library</h1><p>Search chapters, lectures and reference materials.</p></div><a class="studio-link" href="/library?saved=1">Saved chapters</a></header><form class="studio-form mb-4" method="get"><label>Search chapters or topics<input name="q" value="<%= q %>" placeholder="Try algebra, mechanics, organic chemistry…"></label><label>Resource type<select name="kind"><option value="">All resources</option><% [['video','Videos'],['document','Documents'],['link','Websites']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= kind===value?'selected':'' %>><%= label %></option><% }) %></select></label><button class="studio-button">Search library</button></form><% if(user.admin||user.editor){ %><div class="admin-shortcuts"><a href="/admin/materials" class="studio-button">Manage learning materials</a><a href="/admin" class="studio-button secondary">Manage exams and chapters</a></div><% } %><div class="chapter-grid"><% let shown=0; chapters.forEach(ch=>{const p=progress.find(x=>String(x.chapter)===String(ch._id));if(savedOnly&&!p?.bookmarked)return;shown++; %><article class="studio-card"><span class="chapter-label"><%= ch.subjectID?.examID?.examName||'EXAM PREPARATION' %> / <%= ch.subjectID?.subjectName||'Learning' %></span><h2><%= ch.chapterName %></h2><p><%= ch.description %></p><small class="mb-3"><%= p?.completed?' Completed':p?'In progress':'Not started' %> <%= p?.bookmarked?' · Bookmarked':'' %></small><a class="studio-link" href="/learn/<%= ch._id %>">Open chapter →</a></article><% }) %></div><% if(resources.length&&!savedOnly){ %><section class="studio-card"><h2>Resources</h2><% resources.forEach(r=>{ %><a class="studio-row" href="/learn/<%= r.chapterID %>"><strong><%= r.title %></strong><span>Open in chapter →</span></a><% }) %></section><% } %><% if(!shown&&!resources.length){ %><div class="studio-card"><h2>No matching chapters</h2><p>No matching chapters yet. Try another search or ask your administrator to publish learning content.</p></div><% } %></main>

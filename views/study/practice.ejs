<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav') %><header class="study-heading"><div><h1>Mock tests</h1><p>Take timed tests, resume saved attempts and review results.</p></div><a class="studio-link" href="/insights">View performance ↗</a></header><div class="chapter-grid"><% quizzes.forEach(q=>{ %><article class="studio-card"><span class="chapter-label"><%= q.chapterID?.chapterName||'MOCK TEST' %></span><h2><%= q.title %></h2><p><%= q.questions.length %> questions · <%= q.durationMinutes||20 %> minutes</p><small>+<%= q.marks||1 %> correct · −<%= q.penalty||0 %> incorrect</small><form action="/practice/start/<%= q._id %>" method="post" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="studio-button">Start / resume test →</button></form></article><% }) %></div><% if(!quizzes.length){ %><p class="studio-card">Your instructor has not published tests yet.</p><% } %><section class="studio-card"><h2>Recent attempts</h2><% if(!runs.length){ %><p>No test attempts.</p><% } runs.forEach(r=>{ %><a class="studio-row" href="/practice/run/<%= r._id %>"><span><strong><%= r.title %></strong><small><%= r.status==='submitted' ? 'Completed · '+r.result.accuracy+'% accuracy' : 'In progress · saved automatically' %></small></span><b>↗</b></a><% }) %></section></main>

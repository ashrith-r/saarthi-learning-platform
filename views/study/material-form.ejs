<form action="<%= material?.legacyType?'/admin/material-edit/'+material.legacyType+'/'+material._id:'/admin/materials'+(material?'/'+material._id:'') %>" method="post" enctype="multipart/form-data" class="studio-form" data-material-form>
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="chapter" value="<%= chapter._id %>">
<label>Material type<select name="kind"><% [['video','Video lesson'],['document','PDF or document'],['link','Website or other resource']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= material?.kind===value?'selected':'' %>><%= label %></option><% }) %></select></label>
<label>Display order<input type="number" name="position" min="0" max="9999" step="1" value="<%= material?.position||0 %>" required></label><small>Lower numbers appear first within videos or documents.</small>
<label>Title<input name="title" required maxlength="180" value="<%= material?.title||'' %>" placeholder="Give students a clear lesson title"></label>
<label>Description<textarea name="description" rows="3" maxlength="5000" placeholder="What will students learn? Include any instructions."><%= material?.description||'' %></textarea></label>
<label>Video or resource URL<input name="url" type="url" value="<%= material?.url||'' %>" placeholder="https://..."></label><small>YouTube, Vimeo and direct MP4/WebM videos play in the chapter. Other links open in a new tab.</small>
<% if(material?.fileId){ %><a class="studio-link" href="/materials/<%= material.fileId %>" target="_blank" rel="noopener">Preview current PDF</a><label class="check-label"><input type="checkbox" name="removePdf"> Remove the current PDF attachment</label><small>Provide a link or replacement PDF when removing it.</small><% } %>
<% if(!material?.legacyType){ %><label>Upload a PDF (optional)<input type="file" name="pdf" accept="application/pdf,.pdf"></label><small>Maximum 15 MB. Choose “PDF or document” when uploading. <%= material?.filename?'Current document: '+material.filename:'' %></small>
<% } %><div class="form-pair"><label>Instructor (optional)<input name="instructor" maxlength="100" value="<%= material?.instructor||'' %>"></label><label>Duration (optional)<input name="duration" maxlength="40" value="<%= material?.duration||'' %>" placeholder="e.g. 25 minutes"></label></div>
<label class="check-label"><input type="checkbox" name="published" <%= !material||material.published?'checked':'' %>> Publish to students</label><small>Uncheck to hide this material without deleting it.</small>
<p role="status" data-save-feedback hidden></p><button class="studio-button" type="submit"><%= material?'Save changes':'Add material' %></button></form>

<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav') %><header class="study-heading"><div><h1>Study planner</h1><p>Create, schedule and complete study sessions.</p></div></header><section class="studio-card"><h2>Next seven days</h2><p>Dates in <%= timeZone %></p><div class="calendar-week"><% for(let i=0;i<7;i++){const date=new Date(today+'T00:00:00Z');date.setUTCDate(date.getUTCDate()+i);const key=date.toISOString().slice(0,10); %><article><strong><%= date.toLocaleDateString('en',{weekday:'short',timeZone:'UTC'}) %></strong><small><%= key.slice(5) %></small><% tasks.filter(t=>t.date===key).forEach(t=>{ %><p class="calendar-task"><%= t.done?'Completed · ':'' %><%= t.title %></p><% }) %></article><% } %></div><p class="mt-3"><%= tasks.filter(t=>!t.done&&t.date<today).length %> overdue sessions · reschedule them below to keep your plan realistic.</p></section><div class="studio-grid"><section class="studio-card"><h2>Study sessions</h2><% if(!tasks.length){ %><p class="empty-message">No study sessions scheduled.</p><% } tasks.forEach(t=>{ %><form method="post" action="/planner/<%= t._id %>" class="studio-form" style="border-bottom:1px solid #ffffff20;padding-bottom:20px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Session title<input name="title" maxlength="160" value="<%= t.title %>" required></label><label>Scheduled date<input type="date" name="date" value="<%= t.date %>" required></label><label><input type="checkbox" name="done" <%= t.done?'checked':'' %>> Completed</label><button class="studio-button">Update session</button></form><% }) %></section><section class="studio-card"><h2>Add study session</h2><p>Enter a task and choose a date.</p><form method="post" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>What will you study?<input name="title" maxlength="160" required placeholder="Revise electrostatics and solve 10 questions"></label><label>Study date<input type="date" name="date" required></label><button class="studio-button">Add study session +</button></form></section></div></main>

<% layout('/layouts/boilerplate.ejs') %>
<main class="studio"><%- include('nav') %>
<a class="studio-link" href="/library">Back to learning library</a>
<header class="study-heading mt-4"><div><h1><%= chapter.chapterName %></h1><p><%= chapter.description %></p></div><% if(user.admin||user.editor){ %><a class="studio-button" href="/admin/materials?chapter=<%= chapter._id %>">Manage this chapter</a><% } %></header>
<% if(preview){ %><div class="studio-card" role="status"><strong>Student preview</strong><p>Includes hidden materials for review. Archived materials stay excluded. Students see only published materials.</p><a href="/admin/materials?chapter=<%= chapter._id %>">Back to materials</a></div><% } %><div class="studio-grid learning-workspace"><div class="learning-content">
<% const videos=[...lectures.map(l=>({title:l.title,url:l.url,instructor:l.faculty,duration:l.duration,description:'',position:l.position||0})),...materials.filter(m=>m.kind==='video')].sort((a,b)=>(a.position||0)-(b.position||0));videos.forEach(l=>{const source=videoSource(l.url); %>
<section class="studio-card lesson"><h2><%= l.title %></h2><% if(l.instructor||l.duration){ %><p><%= [l.instructor,l.duration].filter(Boolean).join(' · ') %></p><% } %><% if(source?.type==='embed'){ %><iframe class="studio-video" src="<%= source.url %>" title="<%= l.title %>" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe><% }else if(source?.type==='video'){ %><video class="studio-video" controls preload="metadata" src="<%= source.url %>">Your browser does not support this video.</video><% } %><% if(l.description){ %><p class="mt-3"><%= l.description %></p><% } %><% if(source){ %><a class="studio-link" href="<%= l.url %>" target="_blank" rel="noopener noreferrer">Open video in a new tab <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><% }else{ %><p>The video link needs updating. Please contact your instructor.</p><% } %></section><% }) %>
<section class="studio-card"><h2>Learning materials</h2><% const documents=[...notes,...sheets,...materials.filter(m=>m.kind!=='video')].sort((a,b)=>(a.position||0)-(b.position||0));documents.forEach(n=>{let url=n.fileId?'/materials/'+n.fileId:'';if(!url)try{const u=new URL(n.url);if(['https:','http:'].includes(u.protocol))url=u.href;}catch{} %><div class="studio-row"><span class="resource-tile"><i class="bi bi-<%= n.kind==='link'?'link-45deg':'file-earmark-text' %>" aria-hidden="true"></i></span><span><strong><%= n.title %></strong><small><%= n.description|| (n.page?n.page+' pages':'Reference material') %></small></span><% if(url){ %><a class="studio-link" href="<%= url %>" target="_blank" rel="noopener noreferrer"><%= n.fileId?'Read PDF':'Open resource' %> <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><% } %></div><% }) %><% if(!documents.length){ %><p>Your instructor has not added documents or links yet.</p><% } %></section>
<% if(!videos.length){ %><section class="studio-card"><h2>No video lessons</h2><p>Video lessons appear here when your instructor publishes them.</p><% if(user.admin||user.editor){ %><a class="studio-link" href="/admin/materials?chapter=<%= chapter._id %>">Add the first lesson</a><% } %></section><% } %></div>
<aside><section class="studio-card"><h2>Chapter progress and notes</h2><form class="studio-form" method="post" data-preserve-work><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="check-label"><input type="checkbox" name="completed" <%= progress?.completed?'checked':'' %>> Mark chapter complete</label><label class="check-label"><input type="checkbox" name="bookmarked" <%= progress?.bookmarked?'checked':'' %>> Save chapter</label><label>Personal notes<textarea rows="8" name="notes" maxlength="10000" placeholder="Capture an idea or a question to return to."><%= progress?.notes||'' %></textarea></label><button class="studio-button">Save my progress</button></form></section>
<section class="studio-card"><h2>Chapter tests</h2><% quizzes.forEach(q=>{ %><form action="/practice/start/<%= q._id %>" method="post" class="studio-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span><strong><%= q.title %></strong><small><%= q.questions.length %> questions</small></span><button class="studio-button secondary">Start test</button></form><% }) %><% if(!quizzes.length){ %><p>Your instructor has not published a test for this chapter yet.</p><% } %></section></aside></div></main>

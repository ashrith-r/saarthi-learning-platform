<% layout('/layouts/boilerplate.ejs') %><main class="studio assessment-workspace"><%- include('nav') %><div class="study-heading"><div><h1><%= run.title %></h1></div><div><strong id="timer" style="font-size:30px" aria-live="off">--:--</strong><p id="saveStatus" role="status">Your saved answers are restored.</p></div></div><div class="test-palette" aria-label="Question navigation"><% run.questions.forEach((q,i)=>{ %><button type="button" data-jump="<%= i %>"><%= i+1 %></button><% }) %></div><% run.questions.forEach((q,i)=>{ %><section class="studio-card test-question" data-question="<%= q._id %>" data-seconds="<%= run.timeSpent?.[String(q._id)]||0 %>" <%= i?'hidden':'' %>><span class="eyebrow">QUESTION <%= i+1 %> OF <%= run.questions.length %></span><h2 class="mt-3"><%= q.question_text %></h2><% if(q.question_img?.url){ %><img src="<%= q.question_img.url %>" alt="Question diagram" style="max-width:100%;max-height:240px"><% } %><div class="test-options"><% q.options.forEach(o=>{ %><label><input type="radio" name="q<%= q._id %>" value="<%= o._id %>" <%= run.answers[String(q._id)]===String(o._id)?'checked':'' %>> <%= o.text %><% if(o.img?.url){ %><img src="<%= o.img.url %>" alt="Option diagram" style="max-height:130px;max-width:100%"><% } %></label><% }) %></div><button type="button" class="btn btn-outline-secondary clear-answer">Clear answer</button> <label><input type="checkbox" class="flag" <%= run.flags.includes(String(q._id))?'checked':'' %>> Mark for review</label></section><% }) %><div class="study-heading"><div><button id="previous" class="btn btn-outline-secondary">← Previous</button> <button id="next" class="studio-button">Next →</button></div><button id="finish" class="studio-button">Finish test</button></div><form id="submitTest" method="post" action="/practice/run/<%= run._id %>/submit" data-no-loader><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><span id="deadline" data-value="<%= new Date(run.expiresAt).toISOString() %>" hidden></span><script src="/js/test-player.js" defer></script></main>

<% layout('/layouts/boilerplate.ejs') %><main class="studio"><%- include('nav') %><header class="study-heading"><div><h1>Test results</h1><p><%= run.title %></p></div><a class="studio-button" href="/insights">Explore your performance →</a></header><section class="studio-card"><div class="score-display"><%= run.result.score %><small style="font-size:24px"> / <%= run.result.maximum %></small></div><p><%= run.result.correct %> correct · <%= run.result.wrong %> incorrect · <%= run.result.skipped %> skipped · <%= run.result.accuracy %>% accuracy</p></section><% run.result.review.forEach((a,i)=>{ %><section class="studio-card"><span class="eyebrow">QUESTION <%= i+1 %> · <%= a.isCorrect?'CORRECT':a.selected?'REVISIT THIS':'SKIPPED' %></span><h2 class="mt-3"><%= a.question.question_text %></h2><small>Approximate active time: <%= a.seconds||0 %> seconds</small><% a.question.options.forEach(o=>{ %><p><%= String(o._id)===String(a.question.correctOption)?' Correct answer: ':'' %><%= String(o._id)===a.selected?'Your answer: ':'' %><%= o.text %></p><% }) %><details><summary>Understand the solution</summary><p><%= a.question.solution?.text||'An explanation has not been added for this question.' %></p></details></section><% }) %></main>

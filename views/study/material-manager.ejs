<% layout('/layouts/boilerplate.ejs') %>
<main class="studio"><%- include('nav') %>
<header class="study-heading"><div><h1>Learning materials</h1><p>Add videos, upload PDFs and manage resource links by chapter.</p></div><a class="studio-button secondary" href="/learn/<%= selected?._id %>?preview=1">Student preview</a></header>
<% if(!selected){ %><section class="studio-card"><h2>Curriculum required</h2><p>Add an exam, a subject and a chapter before adding learning materials.</p><a class="studio-button" href="/admin/addExam">Add an exam</a><a class="studio-link ms-3" href="/admin">Manage curriculum</a></section><% }else{ %>
<form method="get" class="studio-form chapter-picker"><label>Choose the chapter<select name="chapter"><% chapters.forEach(c=>{ %><option value="<%= c._id %>" <%= String(c._id)===String(selected._id)?'selected':'' %>><%= c.subjectID?.subjectName||'Subject' %> / <%= c.chapterName %></option><% }) %></select></label><button class="studio-button secondary">Load chapter</button></form>
<div class="material-layout"><section class="studio-card"><h2>Add learning material</h2><p>Published materials appear in <a href="/learn/<%= selected._id %>" target="_blank" rel="noopener">the student chapter</a> as soon as you save. An open student page checks for updates automatically.</p><%- include('material-form',{material:null,chapter:selected}) %></section><section class="material-index"><h2><%= selected.chapterName %></h2><% const materialCount=resources.length+lectures.length+notes.length+sheets.length; %><p><%= materialCount %> learning <%= materialCount===1?'material':'materials' %></p>
<% const allMaterials=[...resources.map(m=>({...m.toObject(),legacyType:null})),...lectures.map(m=>({...m.toObject(),legacyType:'lecture',kind:'video',instructor:m.faculty})),...notes.map(m=>({...m.toObject(),legacyType:'note',kind:'document'})),...sheets.map(m=>({...m.toObject(),legacyType:'sheet',kind:'document'}))].sort((a,b)=>(a.position||0)-(b.position||0)); %>
 <% [false,true].forEach(archived=>{ %><h3><%= archived?'Archived materials':'Current materials' %></h3><% const list=allMaterials.filter(m=>Boolean(m.archived)===archived);if(!list.length){ %><p>No <%= archived?'archived':'current' %> materials.</p><% }list.forEach(m=>{ %>
 <details id="material-<%= m._id %>" class="studio-card material-record"><summary><span><strong><%= m.title %></strong><small>Order <%= m.position||0 %> · <%= m.archived?'Archived':m.published!==false?'Published':'Hidden from students' %> · <%= m.kind %></small></span><span class="studio-link">Edit material</span></summary><%- include('material-form',{material:m,chapter:selected}) %><form method="post" action="/admin/material-archive/<%= m.legacyType||'resource' %>/<%= m._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="archived" value="<%= archived?'off':'on' %>"><button class="studio-button secondary"><%= archived?'Restore material':'Archive material' %></button></form></details>
 <% }) }) %><% if(!resources.length&&!lectures.length&&!notes.length&&!sheets.length){ %><p class="empty-message">No materials in this chapter. Use the form to add one.</p><% } %></section></div><% } %></main>

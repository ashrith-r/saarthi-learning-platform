<!DOCTYPE html><html lang="en" data-bs-theme="dark"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="content-version" content="<%= site.revision||0 %>"><meta name="csrf-token" content="<%= csrfToken %>"><title><%= title %></title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<% ['style','studio','design-system','cosmos','observatory','workspace'].forEach(css=>{ %><link rel="stylesheet" href="/css/<%= css %>.css"><% }) %></head><body>
<a class="skip-link" href="#page-content">Skip to content</a><div id="observatory-scene" aria-hidden="true"><div class="observatory-light"></div><canvas id="starfield"></canvas><canvas id="planet-view"></canvas></div>
<% const wrapped=workspace&&user&&!body.includes('workspace-sidebar'); %>
<% if(!wrapped&&!body.includes('workspace-sidebar')){ %><%- include('../includes/navbar') %><% } %>
<div id="flash-messages"><%- include('../includes/flash') %></div>
<% if(wrapped){ %><main class="studio legacy-workspace" id="page-content" tabindex="-1"><%- include('../study/nav') %><div class="legacy-content"><%- body %></div></main><% }else{ %><div id="page-content" tabindex="-1"><%- body %></div><% } %>
<%- include('../includes/footer') %>
<script type="module" src="/js/observatory.js"></script><script src="/js/cosmos.js" defer></script><script src="/js/form-state.js" defer></script><script src="/js/workspace.js" defer></script></body></html>
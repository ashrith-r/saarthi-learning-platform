<% layout('/layouts/boilerplate.ejs') %>
<main class="auth-page">
  <section class="auth-story"><div class="hero-orbit right" aria-hidden="true"></div><h1>Student and administrator access</h1><p>Access lectures, documents, practice tests and study plans.</p></section>
  <section class="auth-panel"><div class="auth-panel-inner"><h2 class="mt-3"><%= tab==='register'?'Create account':'Login' %></h2><p><%= tab==='register'?'Enter your name, email and password.':'Enter your email and password.' %></p>
    <nav class="auth-tabs" aria-label="Account access"><a class="<%= tab!=='register'?'active':'' %>" href="/auth/login">Login</a><a class="<%= tab==='register'?'active':'' %>" href="/auth/login?tab=register">Sign Up</a></nav>
    <form action="<%= tab==='register'?'/auth/register':'/auth/login' %>" method="post" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if(tab==='register'){ %><label for="authName">Full name<input id="authName" name="username" autocomplete="name" placeholder="Your name" required></label><% } %>
      <label for="authEmail">Email address<input id="authEmail" type="email" name="email" autocomplete="email" placeholder="you@example.com" required></label>
      <% if(tab==='register'){ %>
        <label for="verificationMethod">Verify account using<select id="verificationMethod" name="verificationMethod"><% if(!smsEnabled&&!emailEnabled){ %><option selected disabled>Verification unavailable</option><% } %><option value="sms" <%= smsEnabled?'selected':'disabled' %>>Mobile SMS</option><option value="email" <%= !emailEnabled?'disabled':!smsEnabled?'selected':'' %>>Email</option></select></label>
        <label for="authPhone">Mobile number for SMS<input id="authPhone" type="tel" name="phone" autocomplete="tel" maxlength="40" placeholder="+ followed by country code and number"></label>
        <small>Include your country code. With SMS verification, use your verified mobile number for recovery; your email remains your login ID.</small>
        <% if(!smsEnabled){ %><small>SMS verification is currently unavailable.<%= emailEnabled?' Email verification is available.':' Account verification is temporarily unavailable; try again later.' %></small><% } %>
      <% } %>
      <label for="authPassword">Password<input id="authPassword" type="password" name="password" autocomplete="<%= tab==='register'?'new-password':'current-password' %>" placeholder="<%= tab==='register'?'At least 8 characters':'Enter your password' %>" <%- tab==='register'?'minlength="8"':'' %> required></label>
      <% if(tab==='register'){ %><label for="authConfirm">Confirm password<input id="authConfirm" type="password" name="confirm" autocomplete="new-password" placeholder="Repeat your password" required></label><% }else{ %><a href="/auth/forgot-password" class="auth-forgot">Forgot your password?</a><% } %>
      <button class="studio-button" type="submit" <%= tab==='register'&&!smsEnabled&&!emailEnabled?'disabled':'' %>><%= tab==='register'?'Create account':'Login' %> <span aria-hidden="true">→</span></button>
    </form><a class="auth-back" href="/">← Back to home</a>
  </div></section>
</main>

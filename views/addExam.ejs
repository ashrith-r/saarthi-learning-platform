<% layout("/layouts/boilerplate.ejs") %>

<main class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold">Add New Exam</h2>
      <p class="text-muted mb-0">Create a new exam and its subjects.</p>
    </div>

    <a href="/admin" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back
    </a>
  </div>

  <% if (typeof success !== 'undefined' && success.length) { %>
    <div class="alert alert-success">
      <%= success[0] %>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error.length) { %>
    <div class="alert alert-danger">
      <%= error[0] %>
    </div>
  <% } %>

  <div class="card shadow-sm">
    <div class="card-body p-4">

      <form action="/admin/addExam" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Exam Name -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Exam Name
          </label>

          <input
            type="text"
            class="form-control"
            name="examName"
            placeholder="Enter the exam name"
            required
          >
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold" for="courseType">Course type</label>
          <input id="courseType" type="text" class="form-control" name="courseType" list="course-types" maxlength="120" required>
          <datalist id="course-types"><% courseTypes.forEach(type => { %><option value="<%= type %>"><% }) %></datalist>
        </div>
        <!-- Icon -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Icon
          </label>

          <input
            type="text"
            class="form-control"
            name="icon"
            maxlength="64"
          >

          <div class="form-text">Optional Bootstrap icon name, such as stars.</div>
        </div>

        <!-- Buttons -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i>
            Save Exam
          </button>

          <button type="reset" class="btn btn-outline-secondary">
            Reset
          </button>
        </div>

      </form>

    </div>
  </div>

</main>

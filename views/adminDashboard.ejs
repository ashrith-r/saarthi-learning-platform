<% layout('/layouts/boilerplate.ejs') %>
<main class="studio"><%- include('study/nav') %>
<header class="study-heading"><div><h1>Administration</h1><p>Manage curriculum, learning materials and publication.</p></div><a class="studio-button" href="/admin/materials">Manage materials</a></header>
<nav class="admin-shortcuts" aria-label="Administration actions"><a class="studio-button secondary" href="/admin/addExam">Add exam</a><a class="studio-button secondary" href="/admin/quiz/create">Create quiz</a><a class="studio-button secondary" href="/admin/questionBank">Question bank</a><a class="studio-button secondary" href="/admin/addUpdate">Post announcement</a><a class="studio-button secondary" href="/admin/publishing">Review publishing</a></nav>
<section class="metric-grid"><% [[drafts.length,'Tests awaiting publication'],[incomplete.length,'Chapters without published materials'],[stats.materials,'Published materials'],[stats.users,'Registered accounts']].forEach(([value,label])=>{ %><article class="studio-card metric"><span><%= label %></span><strong><%= value %></strong></article><% }) %></section>
<div class="studio-grid"><section class="studio-card"><h2>Tests awaiting publication</h2><% if(!drafts.length){ %><p>No tests awaiting publication.</p><% }drafts.forEach(q=>{ %><a class="studio-row" href="/admin/publishing"><strong><%= q.title %></strong><span><%= q.status %></span></a><% }) %></section><section class="studio-card"><h2>Chapters without published materials</h2><% if(!incomplete.length){ %><p>Every chapter has published learning material.</p><% }incomplete.forEach(c=>{ %><a class="studio-row" href="/admin/materials?chapter=<%= c._id %>"><%= c.chapterName %><span>Add materials</span></a><% }) %></section></div>
<section class="studio-card"><h2>Curriculum</h2><% if(!exams.length){ %><p>No exams. Add an exam to start creating curriculum.</p><% }exams.forEach(exam=>{ %><details class="curriculum-row" open><summary><strong><%= exam.examName %></strong></summary><div class="admin-shortcuts"><a href="/admin/exam/edit/<%= exam._id %>">Edit exam</a><a href="/admin/subject/<%= exam._id %>/add">Add subject</a><a href="/admin/<%= exam._id %>/addQuestion">Add question</a></div><% subjects.filter(s=>String(s.examID)===String(exam._id)).forEach(subject=>{ %><div class="curriculum-subject"><h3><%= subject.subjectName %></h3><div class="admin-shortcuts"><a href="/admin/subject/<%= subject._id %>/edit">Edit subject</a><a href="/admin/subject/<%= subject._id %>/addChapter">Add chapter</a></div><% chapters.filter(c=>String(c.subjectID)===String(subject._id)).forEach(ch=>{ %><div class="studio-row"><strong><%= ch.chapterName %></strong><span><a href="/admin/chapter/<%= ch._id %>/edit">Edit chapter</a> · <a href="/admin/materials?chapter=<%= ch._id %>">Materials</a> · <a href="/learn/<%= ch._id %>?preview=1">Preview</a></span></div><% }) %></div><% }) %></details><% }) %></section>
<section class="studio-card"><h2>Recent publishing activity</h2><% if(!events.length){ %><p>No recorded publishing activity.</p><% }events.forEach(e=>{ %><div class="studio-row"><span><strong><%= e.action %></strong><small><%= e.details %></small></span><small><%= e.actor?.username||'Administrator' %> · <%= new Date(e.createdAt).toISOString().slice(0,16) %> UTC</small></div><% }) %></section>
<% if(user.admin){ %><section class="studio-card"><h2>Accounts and roles</h2><p>Manage content editor permissions in <a href="/admin/publishing">Quiz publishing</a>.</p><% users.forEach(u=>{ %><div class="studio-row"><span><strong><%= u.username %></strong><small><%= u.email %> · <%= u.verified?'Verified':'Unverified' %></small></span><span><%= u.admin?'Administrator':u.editor?'Editor':'Student' %></span><% if(String(u._id)!==String(user._id)){ %><form method="post" action="/admin/users/<%= u._id %>/toggle-admin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="studio-button secondary"><%= u.admin?'Remove administrator role':'Make administrator' %></button></form><% } %></div><% }) %></section><% } %></main>
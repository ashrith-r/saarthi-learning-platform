# Required: use a local database while developing.
MONGO_URL=mongodb://127.0.0.1:27017/saarthi
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret
NODE_ENV=development
PORT=3000

# Required for verification and password reset emails.
BREVO_API_KEY=
# A sender address verified with Brevo.
GOOGLE_USER=

# Required for question image uploads.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Optional: AI question generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Set only behind a known reverse proxy; example: one proxy hop.
# TRUST_PROXY=1

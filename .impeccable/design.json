  "narrative": {
    "northStar": "The Learning Observatory",
    "overview": "A practical learning workspace sits inside a quiet observatory. Near-black space, stable layered stars, blue overhead illumination and a shaded procedural planet establish the scene. Opaque working panels protect curriculum, assessments and administration; orange identifies useful actions.\n\nAtmosphere lives in geometry, lighting and motion. Words describe the actual page, feature or next step: functional titles and necessary instructions, with no promotional or motivational taglines. The user-pinned Resq.io screenshots and Laststack reference establish the visual direction; they are not generated assets or an approved raster composition.",
    "keyCharacteristics": [
      "Near-black space with stable stars, blue overhead light and a dimensional side planet.",
      "Opaque working surfaces, cool readable text and orange primary actions.",
      "Persistent scene continuity on supported workspace pages, with native navigation elsewhere.",
      "Functional copy, responsive controls and static reduced-motion scenes."
    ],
    "rules": [
      {
        "name": "The Task Accent Rule",
        "body": "Orange marks primary actions; blue supports orientation and light. Historical aliases such as --purple resolve to blue and do not authorize purple accents.",
        "section": "colors"
      },
      {
        "name": "The Functional Copy Rule",
        "body": "Titles name a destination or task. Supporting copy explains features, status or instructions. Add no promotional taglines, motivational slogans or fabricated claims.",
        "section": "typography"
      },
      {
        "name": "The Native Continuity Rule",
        "body": "Navigation and form submission work independently of animation. Keep the scene mounted during supported workspace navigation; interpolate from the current pose to the next section pose plus URL variation over (1200ms), taking the shortest yaw path. Complex editors, lessons and tests use native navigation. Root view-transition animations are disabled.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the complete CSS cascade, with workspace.css last, when extending the system.",
      "**Do** preserve stable stars, blue overhead light, a shaded planet and opaque readable task surfaces.",
      "**Do** write functional titles, features, status messages and necessary instructions.",
      "**Do** retain native navigation, keyboard focus, reduced motion and the no-WebGL fallback.",
      "**Do** use genuine chapters, recorded progress and useful empty states.",
      "**Do** preserve upload feedback and safe refresh around student work and playback.",
      "**Do** keep the planner agenda chronological and readable at every viewport."
    ],
    "donts": [
      "**Don't** restore the former light or purple identity or add emojis.",
      "**Don't** add promotional taglines, motivational slogans or fabricated claims.",
      "**Don't** let atmosphere obscure form labels, primary actions or navigation.",
      "**Don't** restore sparks, fireworks or motivational decoration.",
      "**Don't** delay navigation or submission to finish animation.",
      "**Don't** invent a generated comp, seed key, texture asset or completed design-engine verification."
    ]
